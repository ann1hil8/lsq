{
  "model": "RIGOL DP712",
  "transport": "RS-232 SCPI",
  "source": "RIGOL DP700 Programming Guide",
  "commands": [
    {"command":"APPL","access":"set/get","parameters":"[CH1,]voltage[,current] or [CH1[,item]]","range":"voltage 0-53 V; current 0-3.2 A","description":"Set or query the DP712 output voltage and current."},
    {"command":"DISP:WIND:STAT","access":"set/get","description":"Set or query display state."},
    {"command":"*IDN","access":"get","description":"Read instrument identification."},
    {"command":"*OPT","access":"get","description":"Read installed options."},
    {"command":"*RCL","access":"set","description":"Recall an instrument state."},
    {"command":"*RST","access":"set","description":"Reset the instrument."},
    {"command":"*SAV","access":"set","description":"Save an instrument state."},
    {"command":"*TST","access":"get","description":"Run the instrument self-test."},
    {"command":"INST:NSEL","access":"set/get","description":"Select or query the output channel."},
    {"command":"INST:SEL","access":"set/get","description":"Select or query the output channel."},
    {"command":"LIC:SET","access":"set","description":"Install an option license."},
    {"command":"MEAS:ALL","access":"get","description":"Read measured voltage, current, and power."},
    {"command":"MEAS:CURR","access":"get","description":"Read measured output current."},
    {"command":"MEAS:POW","access":"get","description":"Read measured output power."},
    {"command":"MEAS:VOLT","access":"get","description":"Read measured output voltage."},
    {"command":"MEM:STAT:DEL","access":"set","description":"Delete a saved state or timer file."},
    {"command":"MEM:STAT:LOAD","access":"set","description":"Load a saved state or timer file."},
    {"command":"MEM:STAT:LOCK","access":"set/get","description":"Set or query a saved file lock state."},
    {"command":"MEM:STAT:STORE","access":"set","description":"Store a state or timer file."},
    {"command":"MEM:STAT:VALID","access":"get","description":"Query saved file validity."},
    {"command":"OUTP:CVCC","access":"get","description":"Read constant-voltage or constant-current mode."},
    {"command":"OUTP:MODE","access":"get","description":"Read output operating mode."},
    {"command":"OUTP:OCP:ALAR","access":"get","description":"Read overcurrent protection alarm."},
    {"command":"OUTP:OCP:QUES","access":"get","description":"Read overcurrent protection questionable state."},
    {"command":"OUTP:OCP:CLEAR","access":"set","description":"Clear overcurrent protection."},
    {"command":"OUTP:OCP","access":"set/get","description":"Enable or query overcurrent protection."},
    {"command":"OUTP:OCP:VAL","access":"set/get","description":"Set or query overcurrent protection level."},
    {"command":"OUTP:OVP:ALAR","access":"get","description":"Read overvoltage protection alarm."},
    {"command":"OUTP:OVP:QUES","access":"get","description":"Read overvoltage protection questionable state."},
    {"command":"OUTP:OVP:CLEAR","access":"set","description":"Clear overvoltage protection."},
    {"command":"OUTP:OVP","access":"set/get","description":"Enable or query overvoltage protection."},
    {"command":"OUTP:OVP:VAL","access":"set/get","description":"Set or query overvoltage protection level."},
    {"command":"OUTP","access":"set/get","description":"Enable or query output state."},
    {"command":"SOUR1:CURR","access":"set/get","parameters":"value","range":"0-3.2 A","description":"Set or query the DP712 output current."},
    {"command":"SOUR1:CURR:PROT:CLEAR","access":"set","parameters":"none","description":"Clear source overcurrent protection."},
    {"command":"SOUR1:CURR:PROT","access":"set/get","parameters":"value","range":"0-3.2 A","description":"Set or query source overcurrent level."},
    {"command":"SOUR1:CURR:PROT:STAT","access":"set/get","parameters":"ON|OFF","description":"Enable or query source overcurrent protection."},
    {"command":"SOUR1:CURR:PROT:TRIP","access":"get","parameters":"none","description":"Query source overcurrent trip state."},
    {"command":"SOUR1:VOLT","access":"set/get","parameters":"value","range":"0-53 V","description":"Set or query the DP712 output voltage."},
    {"command":"SOUR1:VOLT:PROT:CLEAR","access":"set","parameters":"none","description":"Clear source overvoltage protection."},
    {"command":"SOUR1:VOLT:PROT","access":"set/get","parameters":"value","range":"0-53 V","description":"Set or query source overvoltage level."},
    {"command":"SOUR1:VOLT:PROT:STAT","access":"set/get","parameters":"ON|OFF","description":"Enable or query source overvoltage protection."},
    {"command":"SOUR1:VOLT:PROT:TRIP","access":"get","parameters":"none","description":"Query source overvoltage trip state."},
    {"command":"SYST:BEEP:IMM","access":"set","description":"Issue an immediate beep."},
    {"command":"SYST:BEEP","access":"set/get","description":"Set or query beeper state."},
    {"command":"SYST:BRIG","access":"set/get","description":"Set or query display brightness."},
    {"command":"SYST:COMM:RS232:BAUD","access":"set/get","description":"Set or query RS-232 baud rate."},
    {"command":"SYST:COMM:RS232:DATAB","access":"set/get","description":"Query RS-232 data bits; DP712 is fixed at 8."},
    {"command":"SYST:COMM:RS232:PARIB","access":"set/get","description":"Set or query RS-232 parity."},
    {"command":"SYST:COMM:RS232:STOPB","access":"set/get","description":"Query RS-232 stop bits; DP712 is fixed at 1."},
    {"command":"SYST:ERR","access":"get","description":"Read one system error."},
    {"command":"SYST:FAN","access":"get","description":"Read fan state."},
    {"command":"SYST:KLOCK","access":"set/get","description":"Set or query key lock state."},
    {"command":"SYST:KLOCK:STAT","access":"set/get","description":"Set or query global key lock state."},
    {"command":"SYST:LANG:TYPE","access":"set/get","description":"Set or query language type."},
    {"command":"SYSTem:LOCal","access":"set","description":"Return the instrument to local mode."},
    {"command":"SYST:LOCK","access":"set/get","description":"Set or query remote lock state."},
    {"command":"SYST:POWERON","access":"set/get","description":"Set or query power-on behavior."},
    {"command":"SYST:PRINT","access":"get","description":"Query print status."},
    {"command":"SYSTem:REMote","access":"set","description":"Enter remote mode."},
    {"command":"SYST:RWLOCK","access":"set/get","description":"Set or query remote key lock state."},
    {"command":"SYST:SAVER","access":"set/get","description":"Set or query system save state."},
    {"command":"SYST:SELF:TEST","access":"get","description":"Run the system self-test."},
    {"command":"SYST:TRIG:IN:STAT","access":"set/get","description":"Set or query trigger input."},
    {"command":"SYST:TRIG:OUT:STAT","access":"set/get","description":"Set or query trigger output."},
    {"command":"SYST:VERS","access":"get","description":"Read firmware or SCPI version."},
    {"command":"TIMER:CYCLES","access":"set/get","description":"Set or query timer cycles."},
    {"command":"TIMER:ENDSTATE","access":"set/get","description":"Set or query timer end state."},
    {"command":"TIMER:GROUPS","access":"set/get","description":"Set or query timer output groups."},
    {"command":"TIMER:PARAMETER","access":"set/get","description":"Set or query timer voltage/current/time parameters."},
    {"command":"TIMER:STATE","access":"set/get","description":"Set or query timer state."},
    {"command":"TIMER:TRIGGER","access":"set/get","description":"Set or query timer trigger mode."}
  ]
}
